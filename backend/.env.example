DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/contractor_requests
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
STORAGE_ROOT=storage
REQUIRE_WORK_RESULT_FOR_COMPLETION=true
AUTH_TOKEN_SECRET=dev-only-change-before-production
CONNECTION_SECRETS_KEY=dev-only-change-before-production
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
PUBLIC_BASE_URL=http://127.0.0.1:8000
HSTS_ENABLED=false
MAX_REQUEST_BODY_BYTES=26214400
MAX_JSON_BODY_BYTES=1048576
MAX_MULTIPART_BODY_BYTES=26214400
MAX_UPLOAD_FILE_BYTES=20971520
MAX_FILES_PER_REQUEST=1
DEFAULT_PAGE_LIMIT=100
MAX_PAGE_LIMIT=200
MAX_SEARCH_LENGTH=128
RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT_PER_MINUTE=10
APP_DEBUG=false
